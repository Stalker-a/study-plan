# Скопируй этот файл в .env и заполни.

# Пароль для входа на сайт (от 8 символов). Придумай свой, не используй пароли от других сервисов.
SITE_PASSWORD=

# Папка с книгами
BOOKS_DIR=C:\учеба\книги

# Адрес сервера. 127.0.0.1 — сайт виден только с этого ноутбука;
# на телефон его выставляет `tailscale serve` (см. README).
HOST=127.0.0.1
PORT=8000

# Необязательно: ключ подписи сессий. Если пусто — сгенерируется в instance/secret_key.
SECRET_KEY=
